# =============================================================================
# StreamOps - Environment Variables Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
NODE_ENV=production
APP_NAME=StreamOps
APP_VERSION=1.0.0

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
API_PORT=8080
DASHBOARD_PORT=3000
HOST=0.0.0.0

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# -----------------------------------------------------------------------------
# Format: postgresql://user:password@host:port/database
# Use environment-specific values for each deployment; do not commit real credentials.
DATABASE_URL="postgresql://user:password@host:5432/streamops"
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# -----------------------------------------------------------------------------
# Redis Configuration (Optional - for caching)
# -----------------------------------------------------------------------------
# Format: redis://host:port or redis://:password@host:port
# REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Telegram Bot Configuration
# -----------------------------------------------------------------------------
# Comma-separated list of admin Telegram IDs (numbers only)
# These users can send videos to bot and receive file_id for import
ADMIN_TELEGRAM_IDS=123456789,987654321

# Note: Bot token is stored in database (telegram_config table)
# Configure via admin panel after deployment

# -----------------------------------------------------------------------------
# Payme Payment Integration
# -----------------------------------------------------------------------------
PAYME_MERCHANT_ID=your_payme_merchant_id
PAYME_KEY=your_payme_merchant_key
PAYME_IS_TEST=false

# For testing in Payme sandbox:
# PAYME_IS_TEST=true
# PAYME_MERCHANT_ID=test_merchant_id
# PAYME_KEY=test_key

# -----------------------------------------------------------------------------
# Click Payment Integration
# -----------------------------------------------------------------------------
CLICK_MERCHANT_ID=your_click_merchant_id
CLICK_SERVICE_ID=your_click_service_id
CLICK_SECRET_KEY=your_click_secret_key
CLICK_MERCHANT_USER_ID=your_click_merchant_user_id

# -----------------------------------------------------------------------------
# Uzum Payment Integration
# -----------------------------------------------------------------------------
UZUM_MERCHANT_ID=your_uzum_merchant_id
UZUM_SECRET_KEY=your_uzum_secret_key
UZUM_TERMINAL_ID=your_uzum_terminal_id

# -----------------------------------------------------------------------------
# Paynet Payment Integration
# -----------------------------------------------------------------------------
PAYNET_TERMINAL_ID=your_paynet_terminal_id
PAYNET_SERVICE_ID=your_paynet_service_id
PAYNET_PASSWORD=your_paynet_password

# -----------------------------------------------------------------------------
# Anor Payment Integration
# -----------------------------------------------------------------------------
ANOR_MERCHANT_ID=your_anor_merchant_id
ANOR_SECRET_KEY=your_anor_secret_key

# -----------------------------------------------------------------------------
# NBU Payment Integration
# -----------------------------------------------------------------------------
NBU_MERCHANT_ID=your_nbu_merchant_id
NBU_TERMINAL_ID=your_nbu_terminal_id
NBU_SECRET_KEY=your_nbu_secret_key

# -----------------------------------------------------------------------------
# Uzcard/Humo Payment Integration
# -----------------------------------------------------------------------------
UZCARD_MERCHANT_ID=your_uzcard_merchant_id
UZCARD_TERMINAL_ID=your_uzcard_terminal_id
UZCARD_SECRET_KEY=your_uzcard_secret_key

# -----------------------------------------------------------------------------
# Octo Payment Integration
# -----------------------------------------------------------------------------
OCTO_MERCHANT_ID=your_octo_merchant_id
OCTO_SHOP_ID=your_octo_shop_id
OCTO_SECRET_KEY=your_octo_secret_key

# -----------------------------------------------------------------------------
# Temporary P2P Payment Integration
# -----------------------------------------------------------------------------
# Keep disabled until the provider's official API/webhook specification,
# terms, and launch requirements have been verified.
BILLING_ENABLED_PROVIDERS=
P2P_ENABLED=false
# P2P_MERCHANT_ID=your_p2p_merchant_id
# P2P_SECRET_KEY=your_p2p_secret_key
# P2P_API_URL=https://provider.example/api
# P2P_CHECKOUT_BASE_URL=https://provider.example/checkout

# -----------------------------------------------------------------------------
# Security Configuration
# -----------------------------------------------------------------------------
# Secret keys for JWT and session management
# Generate strong random strings for each environment and keep them out of git.
JWT_SECRET=replace_with_strong_random_secret_at_least_32_chars
JWT_EXPIRY=7d
SESSION_SECRET=replace_with_strong_random_session_secret

# Optional one-time admin bootstrap. Leave unset after the account is created.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_unique_password_at_least_12_chars
# BOOTSTRAP_ADMIN_NAME=Administrator

# Password hashing (bcrypt salt rounds)
BCRYPT_SALT_ROUNDS=12

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
# Options: error, warn, info, debug
LOG_LEVEL=info
# Options: json, pretty
LOG_FORMAT=json

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins
# Use * for development only, specify exact domains in production
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Public domain used by the reverse proxy and TLS certificate.
PUBLIC_DOMAIN=example.com

# -----------------------------------------------------------------------------
# File Upload Configuration
# -----------------------------------------------------------------------------
# Maximum file size in bytes (default: 50MB)
MAX_FILE_SIZE=52428800
# Upload directory (absolute path)
UPLOAD_DIR=/var/uploads

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
# Enable/disable features without code changes
FEATURE_ANALYTICS=true
FEATURE_NOTIFICATIONS=true
FEATURE_ADVERTISING=false
FEATURE_VIEWING=false

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
# Window duration in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
# Max requests per window per IP (default: 100)
RATE_LIMIT_MAX_REQUESTS=100

# -----------------------------------------------------------------------------
# Email Configuration (Optional - for notifications)
# -----------------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# SMTP_FROM=noreply@yourdomain.com

# -----------------------------------------------------------------------------
# SSL/TLS Configuration (for reverse proxy)
# -----------------------------------------------------------------------------
# SSL_CERT_PATH=/etc/ssl/certs/yourdomain.crt
# SSL_KEY_PATH=/etc/ssl/private/yourdomain.key

# -----------------------------------------------------------------------------
# Backup Configuration
# -----------------------------------------------------------------------------
# Backup directory
BACKUP_DIR=/var/backups/streamops
# Backup retention days
BACKUP_RETENTION_DAYS=30

# -----------------------------------------------------------------------------
# Monitoring Configuration (Optional)
# -----------------------------------------------------------------------------
# Sentry DSN for error tracking
# SENTRY_DSN=https://your-sentry-dsn
# DataDog API key
# DATADOG_API_KEY=your-datadog-key

# =============================================================================
# DEVELOPMENT ONLY (Do not use in production)
# =============================================================================
# Uncomment for local development
NODE_ENV=development
# CORS_ORIGINS=*
# LOG_LEVEL=debug
# LOG_FORMAT=pretty
# PAYME_IS_TEST=true

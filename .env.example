# Copy is generated by scripts/install.sh. Never commit the generated .env.
NODE_ENV=production
APP_NAME=KinoBot
APP_VERSION=1.0.1
PUBLIC_DOMAIN=${APP_DOMAIN}

# Self-hosted PostgreSQL. App login is least-privilege; migrator uses admin URL.
POSTGRES_DB=${POSTGRES_DB}
POSTGRES_USER=${POSTGRES_USER}
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
APP_DB_USER=${APP_DB_USER}
APP_DB_PASSWORD=${APP_DB_PASSWORD}
DATABASE_URL=${DATABASE_URL}
MIGRATION_DATABASE_URL=${MIGRATION_DATABASE_URL}
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Runtime
API_PORT=8080
DASHBOARD_PORT=3000
HOST=0.0.0.0
TELEGRAM_POLLING_ENABLED=${TELEGRAM_POLLING_ENABLED}
REDIS_URL=redis://redis:6379

# Exact browser origins. Do not use a wildcard in production.
CORS_ORIGINS=${CORS_ORIGINS}
JWT_ACCESS_SECRET=${JWT_ACCESS_SECRET}
JWT_REFRESH_SECRET=${JWT_REFRESH_SECRET}
SESSION_SECRET=${SESSION_SECRET}
BCRYPT_SALT_ROUNDS=12
ENABLE_ROLE_FALLBACK=false

# Telegram administrator IDs, comma-separated numeric IDs. Set before deploy.
ADMIN_TELEGRAM_IDS=REPLACE_WITH_TELEGRAM_USER_IDS

# Optional first-run bootstrap. Leave blank unless the seed flow is approved.
SUPER_ADMIN_NAME=Developer
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Nginx TLS files are issued by certbot during install.sh.
TLS_CERT_FILE=${TLS_CERT_FILE}
TLS_KEY_FILE=${TLS_KEY_FILE}

# Audit retention remains disabled until its separate DB credential is provisioned.
AUDIT_ENABLED=true
AUDIT_RETENTION_ENABLED=false
DATABASE_URL_ARCHIVER=

# Payment providers. Add production credentials only when enabled and verified.
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_IS_TEST=false
P2P_ENABLED=false
P2P_MERCHANT_ID=
P2P_SECRET_KEY=
P2P_API_URL=
P2P_CHECKOUT_BASE_URL=
BILLING_ENABLED_PROVIDERS=

CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=
UZUM_MERCHANT_ID=
UZUM_SECRET_KEY=
UZUM_TERMINAL_ID=
PAYNET_TERMINAL_ID=
PAYNET_SERVICE_ID=
PAYNET_PASSWORD=
ANOR_MERCHANT_ID=
ANOR_SECRET_KEY=
NBU_MERCHANT_ID=
NBU_TERMINAL_ID=
NBU_SECRET_KEY=
UZCARD_MERCHANT_ID=
UZCARD_TERMINAL_ID=
UZCARD_SECRET_KEY=
OCTO_MERCHANT_ID=
OCTO_SHOP_ID=
OCTO_SECRET_KEY=

LOG_LEVEL=info
LOG_FORMAT=json
UPLOAD_DIR=/var/uploads
MAX_FILE_SIZE=52428800
BACKUP_DIR=/var/backups/kinobot
BACKUP_RETENTION_DAYS=30
